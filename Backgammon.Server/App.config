<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings configSource="DBSecrets.config" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
	<system.serviceModel>
		<behaviors>
			<serviceBehaviors>
				<behavior name="mexBehavior">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>

		<services>
			<service
				name="Backgammon.Server.Services.LeaderboardService"
				behaviorConfiguration="mexBehavior">
				<endpoint
					address="LeaderboardService"
					binding="netTcpBinding"
					bindingConfiguration=""
					contract="Backgammon.Server.Services.ILeaderboardService" />

				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:9002" />
						<add baseAddress="net.tcp://localhost:9001" />
					</baseAddresses>
				</host>
			</service>
            <service 
                name="Backgammon.Server.Services.AuthenticationService"
                behaviorConfiguration="mexBehavior">
                <endpoint address="AuthenticationService"
                          binding="netTcpBinding"
                          bindingConfiguration=""
                          contract="Backgammon.Server.Services.IAuthenticationService" />
                <host>
                    <baseAddresses>
                        <add baseAddress="http://localhost:9002/AuthenticationService" />
                        <add baseAddress="net.tcp://localhost:9001" />
                    </baseAddresses>
                </host>
            </service>
            <service 
                name="Backgammon.Server.Services.LogOutService"
                behaviorConfiguration="mexBehavior">
                <endpoint address="LogOutService"
                          binding="netTcpBinding"
                          bindingConfiguration=""
                          contract="Backgammon.Server.Services.ILogOutService" />
                <host>
                    <baseAddresses>
                        <add baseAddress="http://localhost:9002/LogOutService" />
                        <add baseAddress="net.tcp://localhost:9001" />
                    </baseAddresses>
                </host>
            </service>
            <service 
                name="Backgammon.Server.Services.RegistrationService"
                behaviorConfiguration="mexBehavior">
                <endpoint address="RegistrationService"
                          binding="netTcpBinding"
                          bindingConfiguration=""
                          contract="Backgammon.Server.Services.IRegistrationService" />

                <host>
                    <baseAddresses>
                        <add baseAddress="http://localhost:9002/RegistrationService" />
                        <add baseAddress="net.tcp://localhost:9001" />
                    </baseAddresses>
                </host>
            </service>
		</services>
	</system.serviceModel>
</configuration>