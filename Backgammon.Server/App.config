<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings configSource="DBSecrets.config" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="LeaderboardTcpBinding">
					<security mode="Transport">
						<transport clientCredentialType="Windows" />
					</security>
				</binding>
			</netTcpBinding>
		</bindings>

		<services>
			<service
			  name="Backgammon.Server.Services.LeaderboardService"
			  behaviorConfiguration="LeaderboardServiceBehavior">

				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:9001/LeaderboardService" />
					</baseAddresses>
				</host>

				<endpoint
				  address=""
				  binding="netTcpBinding"
				  bindingConfiguration="LeaderboardTcpBinding"
				  contract="Backgammon.Server.Services.LeaderboardService" />

				<endpoint
				  address="mex"
				  binding="mexTcpBinding"
				  contract="IMetadataExchange" />
			</service>
		</services>

		<behaviors>
			<serviceBehaviors>
				<behavior name="LeaderboardServiceBehavior">
					<serviceMetadata />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>