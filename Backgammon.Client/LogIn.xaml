<Window x:Class="Backgammon.Client.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backgammon.Client"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="{x:Static properties:Resources.Guest}" HorizontalAlignment="Left" Margin="110,287,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="{x:Static properties:Resources.SignIn}" HorizontalAlignment="Left" Margin="110,241,0,0" VerticalAlignment="Top" Click="Button_Click" Height="32" Width="99"/>

    </Grid>
</Window>
