<Page x:Class="Backgammon.Client.Leaderboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Leaderboard"
      Background="White">

    <Grid>

        <TextBlock
            HorizontalAlignment="Center"
            Margin="0,16,0,0"
            VerticalAlignment="Top"
            FontSize="25"
            Text="{x:Static properties:Resources.Leaderboard}"/>

        <Border
            BorderBrush="Black"
            BorderThickness="1"
            Margin="52,54,52,54">

            <ListBox x:Name="LeaderboardListBox">

                <ListBoxItem>
                    <Grid Width="650">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Nombre de usuario" FontSize="15"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Static properties:Resources.Wins}" FontSize="15"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Static properties:Resources.Points}" FontSize="15"/>

                    </Grid>
                </ListBoxItem>

               

            </ListBox>

        </Border>
        <Button Content="{x:Static properties:Resources.Back}" HorizontalAlignment="Left" Margin="708,401,0,0" VerticalAlignment="Top"/>

    </Grid>
</Page>