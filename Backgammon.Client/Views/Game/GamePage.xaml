<Page x:Class="Backgammon.Client.Views.Game.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Game"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1250"
      xmlns:controls="clr-namespace:Backgammon.Client.Views.Game.Controls"
      Title="GamePage">

    <Grid Background="#050914">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <controls:BoardControl
            x:Name="boardControlGame"
            Grid.Column="0"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20" CornerRadius="15" Background="#303B63">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock
                        Text="AQUI VA POZO"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />
                    <TextBlock 
                        Text="120" 
                        Margin="20, 0, 0, 0" 
                        Foreground="White" 
                        FontSize="36"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock
                    Text="Es tu turno"
                    Foreground="White"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>
                <TextBlock Text="00:07" 
                           Foreground="White" 
                           FontSize="26" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 10">
                <TextBlock
                    Text="Tiempo global"
                    Foreground="White"
                    FontSize="30"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />
                <TextBlock Text="02:00" Margin="15,0,0,0" Foreground="White" FontSize="25" VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 10">
                <Button Content="Deshacer" 
                        Width="120" 
                        Height="45" 
                        Margin="5"
                        IsEnabled="False"/>
                <Button Content="Confirmar" 
                        Width="120" 
                        Height="45" 
                        Margin="5"
                        IsEnabled="False"/>
            </StackPanel>
            <Button
                Grid.Row="4"
                Content="Tirar dados"
                Width="140"
                Height="45"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Click="OnRollDiceButtonClick"
                IsEnabled="False"/>
        </Grid>
        <Grid
            x:Name="gridMatchAnnouncement"
            Grid.ColumnSpan="2"
            Panel.ZIndex="10"
            Background="Transparent"
            Visibility="Collapsed">

            <Border
                Padding="35,25"
                Background="#050914"
                BorderBrush="#00C9F2"
                BorderThickness="2"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="650">

                <StackPanel>
                    <TextBlock
                        x:Name="textBlockMatchAnnouncement"
                        Foreground="#00C9F2"
                        FontSize="36"
                        FontWeight="Bold"
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        x:Name="textBlockMatchCountdown"
                        Margin="0,15,0,0"
                        Foreground="#E795EC"
                        FontSize="64"
                        FontWeight="Bold"
                        TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
