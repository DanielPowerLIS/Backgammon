<UserControl x:Class="Backgammon.Client.Views.Game.Controls.BoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Backgammon.Client.Views.Game.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="500"
             xmlns:controls="clr-namespace:Backgammon.Client.Views.Game.Controls">

    <Canvas x:Name="BoardCanvas" Background="#050914">
        <Polygon Points="50,30,100, 30 75, 220" Stroke="#00C9F2" StrokeThickness="2"/>
        <Polygon Points="110, 30 160, 30 135, 220" Stroke="#E795EC" StrokeThickness="2"/>
        <controls:CheckerControl x:Name="TestChecker" Canvas.Left="55" Canvas.Top="70"/>
    </Canvas>
    
</UserControl>
