<UserControl
    x:Class="Backgammon.Client.Views.Game.Controls.MatchStartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Border
            Padding="35,25"
            Background="#050914"
            BorderBrush="#00C9F2"
            BorderThickness="2"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="650">

            <StackPanel>
                <TextBlock
                    x:Name="textBlockAnnouncement"
                    Foreground="#00C9F2"
                    FontSize="36"
                    FontWeight="Bold"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="textBlockCountdown"
                    Margin="0,15,0,0"
                    Foreground="#E795EC"
                    FontSize="64"
                    FontWeight="Bold"
                    TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>