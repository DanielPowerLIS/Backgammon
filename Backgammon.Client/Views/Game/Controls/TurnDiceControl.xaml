<UserControl
    x:Class="Backgammon.Client.Views.Game.Controls.TurnDiceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Backgammon.Client.Views.Game.Controls"
    xmlns:properties="clr-namespace:Backgammon.Client.Properties">

    <UserControl.Resources>
        <Style x:Key="DieSelectorStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="BorderDieSelection"
                            Padding="8"
                            Background="#171C3B"
                            BorderBrush="#303B63"
                            BorderThickness="2"
                            CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                                    TargetName="BorderDieSelection"
                                    Property="BorderBrush"
                                    Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            x:Name="textBlockDoubles"
            Margin="0,0,0,10"
            Text="{x:Static properties:Resources.Message_Doubles}"
            Foreground="#E795EC"
            FontSize="28"
            FontWeight="Bold"
            TextAlignment="Center"
            Visibility="Collapsed"/>

        <Grid x:Name="GridDice" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton
                x:Name="radioButtonFirstDie"
                Grid.Column="0"
                Margin="4"
                Style="{StaticResource DieSelectorStyle}"
                AutomationProperties.Name="{x:Static properties:Resources.Label_FirstDie}"
                IsEnabled="False">

                <StackPanel>
                    <controls:DieControl
                        x:Name="dieControlFirst"
                        Width="90"
                        Height="90"/>

                    <TextBlock
                        x:Name="textBlockFirstDieUses"
                        Margin="0,8,0,0"
                        Foreground="White"
                        FontSize="20"
                        TextAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton
                x:Name="radioButtonSecondDie"
                Grid.Column="1"
                Margin="4"
                Style="{StaticResource DieSelectorStyle}"
                AutomationProperties.Name="{x:Static properties:Resources.Label_SecondDie}"
                IsEnabled="False">

                <StackPanel>
                    <controls:DieControl
                        x:Name="dieControlSecond"
                        Width="90"
                        Height="90"/>

                    <TextBlock
                        x:Name="textBlockSecondDieUses"
                        Margin="0,8,0,0"
                        Foreground="White"
                        FontSize="20"
                        TextAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </Grid>

        <Button
            x:Name="buttonRollDice"
            Content="{x:Static properties:Resources.Button_RollDice}"
            Width="140"
            Height="45"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            IsEnabled="False"/>
    </StackPanel>
</UserControl>