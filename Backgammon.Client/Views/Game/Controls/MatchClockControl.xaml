<UserControl
    x:Class="Backgammon.Client.Views.Game.Controls.MatchClockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:Backgammon.Client.Properties"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="{x:Static properties:Resources.TextBlock_GraceTimeLabel}"
            Margin="0,5,12,5"
            Foreground="White"
            FontSize="22"
            TextWrapping="Wrap"
            VerticalAlignment="Center"/>

        <TextBlock
            x:Name="textBlockGraceTime"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,5"
            Foreground="#00C9F2"
            FontSize="26"
            FontWeight="Bold"
            VerticalAlignment="Center"/>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="{x:Static properties:Resources.TextBlock_GlobalTimeLabel}"
            Margin="0,5,12,5"
            Foreground="White"
            FontSize="22"
            TextWrapping="Wrap"
            VerticalAlignment="Center"/>

        <TextBlock
            x:Name="textBlockGlobalTime"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,5"
            Foreground="#E795EC"
            FontSize="26"
            FontWeight="Bold"
            VerticalAlignment="Center"/>
    </Grid>
</UserControl>