<UserControl
    x:Class="Backgammon.Client.Views.Game.Controls.CaptureNoticeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    IsHitTestVisible="False"
    Focusable="False">

    <Grid>
        <Border
            Margin="20"
            Padding="30,20"
            MaxWidth="750"
            Background="#050914"
            BorderBrush="#00C9F2"
            BorderThickness="2"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                x:Name="textBlockCaptureMessage"
                Foreground="#00C9F2"
                FontSize="42"
                FontWeight="Bold"
                TextAlignment="Center"
                TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>