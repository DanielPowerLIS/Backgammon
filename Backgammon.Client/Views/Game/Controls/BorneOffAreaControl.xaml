<UserControl
    x:Class="Backgammon.Client.Views.Game.Controls.BorneOffAreaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        x:Name="borderArea"
        Padding="8"
        MinHeight="48"
        BorderThickness="2"
        CornerRadius="8"
        Background="#0F1526">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="textBlockCheckerCount"
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                TextWrapping="Wrap"
                VerticalAlignment="Center"/>

            <StackPanel
                x:Name="stackPanelCheckers"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"/>
        </Grid>
    </Border>
</UserControl>