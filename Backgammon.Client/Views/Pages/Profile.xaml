<Page x:Class="Backgammon.Client.Views.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Profile"
      Background="White">

    <Grid>
        <Grid Grid.ColumnSpan="1">
            <Separator HorizontalAlignment="Left" Margin="44,221,0,0" VerticalAlignment="Top" Height="3" Width="420" Background="Black" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Grid.RowSpan="1">
                <Separator.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-89.986"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Separator.RenderTransform>
            </Separator>
            <Ellipse HorizontalAlignment="Left" Height="111" Margin="70,70,0,0" Stroke="Black" VerticalAlignment="Top" Width="107" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.375"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Label Content="Label" HorizontalAlignment="Left" Margin="32,203,0,0" VerticalAlignment="Top" Width="101" FontSize="20"/>
            <Button Content="Button" HorizontalAlignment="Left" Margin="180,0,0,0" VerticalAlignment="Center" Click="Button_Click">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>
            <Label Content="ID" HorizontalAlignment="Left" Margin="50,310,0,0" VerticalAlignment="Top" FontSize="20"/>
            <Label Content="Label" HorizontalAlignment="Left" Margin="162,310,0,0" VerticalAlignment="Top" FontSize="20"/>
            <StackPanel Margin="283,10,10,23">
                <Grid Height="40">
                    <Label Content="{x:Static properties:Resources.Points}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                    <Label Content="{x:Static properties:Resources.Wins}" HorizontalAlignment="Left" Margin="223,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                    <Label Content="18" HorizontalAlignment="Left" Margin="112,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                    <Label Content="18" HorizontalAlignment="Left" Margin="369,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                </Grid>
                <Grid Height="40">
                    <Label Content="{x:Static properties:Resources.DateJoined}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                    <Label Content="18" HorizontalAlignment="Left" Margin="244,0,0,0" VerticalAlignment="Center" FontSize="20"/>
                </Grid>
                <Grid Height="136">
                    <Label Content="{x:Static properties:Resources.Description}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <TextBlock HorizontalAlignment="Left" Margin="17,52,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="74" Width="480" FontSize="15"/>
                </Grid>
                <Grid Height="187">
                    <Label Content="{x:Static properties:Resources.SocialMedia}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="Facebook" HorizontalAlignment="Left" Margin="10,52,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="Instagram" HorizontalAlignment="Left" Margin="10,89,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="TikTok" HorizontalAlignment="Left" Margin="10,125,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="link" HorizontalAlignment="Left" Margin="150,52,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="link" HorizontalAlignment="Left" Margin="150,89,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Label Content="link" HorizontalAlignment="Left" Margin="150,125,0,0" VerticalAlignment="Top" FontSize="20"/>
                    <Button Content="{x:Static properties:Resources.AddLink}" HorizontalAlignment="Left" Margin="414,61,0,0" VerticalAlignment="Top"/>
                    <Button Content="{x:Static properties:Resources.AddLink}" HorizontalAlignment="Left" Margin="414,97,0,0" VerticalAlignment="Top"/>
                    <Button Content="{x:Static properties:Resources.AddLink}" HorizontalAlignment="Left" Margin="414,128,0,0" VerticalAlignment="Top"/>
                    <Button Content="{x:Static properties:Resources.Back}" Margin="414,160,9,8"/>
                </Grid>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
