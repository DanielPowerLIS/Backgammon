<Page x:Class="Backgammon.Client.Views.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="{x:Static properties:Resources.TextBlock_Login}">

    <Page.Resources>
        <RadialGradientBrush
            x:Key="PageBackgroundBrush"
            Center="0.5,0.35"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop
                Color="#171C2B"
                Offset="0" />

            <GradientStop
                Color="#0C1220"
                Offset="0.55" />

            <GradientStop
                Color="#050914"
                Offset="1" />

        </RadialGradientBrush>

        <Style
            x:Key="LoginTextBoxStyle"
            TargetType="TextBox">

            <Setter
                Property="Background"
                Value="#FAFAFA" />

            <Setter
                Property="BorderBrush"
                Value="#999999" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Foreground"
                Value="#202020" />

            <Setter
                Property="CaretBrush"
                Value="#202020" />

            <Setter
                Property="FontFamily"
                Value="Segoe UI" />

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="Padding"
                Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="Placeholder"
                                    Text="{Binding Tag,
                                        RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#7D7D7D"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="Text"
                                Value="">

                                <Setter
                                    TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                            </Trigger>

                            <Trigger
                                Property="IsKeyboardFocused"
                                Value="True">

                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="#17B8B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="LoginPasswordBoxStyle"
            TargetType="PasswordBox">

            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="#17B8B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SignInButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="#17B8B1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#20CBC3" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#109A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SignUpLinkButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#17B8B1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#109A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both">

            <Grid
                Width="900"
                Height="450">

                <Border
                    Width="440"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F5F5F5"
                    CornerRadius="28">

                    <Grid Margin="55,35,55,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="{x:Static properties:Resources.TextBlock_Login}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#202020" />

                        <TextBox
                            x:Name="textBoxUsernameOrEmail"
                            Grid.Row="2"
                            Height="54"
                            Tag="{x:Static properties:Resources.TextBox_UsernameOrEmail}"
                            Style="{StaticResource LoginTextBoxStyle}" />

                        <Grid
                            Grid.Row="4"
                            Height="54">

                            <PasswordBox
                                x:Name="passwordBoxPassword"
                                PasswordChanged="OnPasswordChanged"
                                Style="{StaticResource LoginPasswordBoxStyle}" />

                            <TextBlock
                                x:Name="textBlockPasswordPlaceholder"
                                Text="{x:Static properties:Resources.PasswordBox_Password}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#7D7D7D"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False" />
                        </Grid>

                        <Button
                            x:Name="buttonSignIn"
                            Grid.Row="6"
                            Height="54"
                            Content="{x:Static properties:Resources.Button_SignIn}"
                            Style="{StaticResource SignInButtonStyle}"
                            Click="OnSignInClick"/>

                        <StackPanel
                            Grid.Row="8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                Text="{x:Static properties:Resources.TextBlock_DoNotHaveAnAccount}"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                Foreground="#78839A" />

                            <Button
                                x:Name="buttonSignUp"
                                Content="{x:Static properties:Resources.Button_SignUp}"
                                Margin="8,0,0,0"
                                Style="{StaticResource SignUpLinkButtonStyle}" />
                        </StackPanel>
                    </Grid>

                </Border>
                <Button Content="{x:Static properties:Resources.Button_Back}" Background="#080D1A" BorderBrush="#00C9F2" BorderThickness="2" Foreground="#E795EC" FontSize="16" Cursor="Hand" HorizontalAlignment="Left" Margin="750,400,0,0" VerticalAlignment="Top" Width="100" Height="35" Click="OnBackClick"/>
            </Grid>
        </Viewbox>
    </Grid>
        
</Page>
