<Page x:Class="Backgammon.Client.Views.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="900"
      Title="{x:Static properties:Resources.TextBlock_Login}">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.65" RadiusY="0.85">
            <GradientStop Color="#111B35" Offset="0" />
            <GradientStop Color="#090F1E" Offset="0.55" />
            <GradientStop Color="#040810" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="NeonButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#21F0F5" Offset="0" />
            <GradientStop Color="#00CBE5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#69FAFF" Offset="0" />
            <GradientStop Color="#16DCEF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00BED4" Offset="0" />
            <GradientStop Color="#009DBB" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="NeonTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#EC99F4" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#090F1E" />
            <Setter Property="BorderBrush" Value="#00DAF0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#DDC5FA" />
            <Setter Property="CaretBrush" Value="#F3A1F5" />
            <Setter Property="SelectionBrush" Value="#087C98" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BorderInput"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="textBlockPlaceholder"
                                           Text="{Binding Tag,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#D2BFEF"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="textBlockPlaceholder"
                                        Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderInput"
                                        Property="BorderBrush" Value="#91F9FF" />
                                <Setter TargetName="BorderInput" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00DFF5" ShadowDepth="0"
                                                          BlurRadius="10" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderInput" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#090F1E" />
            <Setter Property="BorderBrush" Value="#00DAF0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#DDC5FA" />
            <Setter Property="CaretBrush" Value="#F3A1F5" />
            <Setter Property="SelectionBrush" Value="#087C98" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="BorderInput"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderInput"
                                        Property="BorderBrush" Value="#91F9FF" />
                                <Setter TargetName="BorderInput" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00DFF5" ShadowDepth="0"
                                                          BlurRadius="10" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderInput" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NeonButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="#04121E" />
            <Setter Property="BorderBrush" Value="#8CF9FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#00DDF3" ShadowDepth="0"
                                                  BlurRadius="18" Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderButton" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderButton" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignUpLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F29AF3" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#CE69DD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="900" Height="480">
                <Border Width="430" Height="340"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#090F1E" BorderBrush="#00E5F4"
                        BorderThickness="2" CornerRadius="12">
                    <Grid Margin="58,30,58,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="46" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <!-- Offset text layers approximate the prototype's neon outline. -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_Login}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_Login}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_Login}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_Login}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                       Foreground="#090F1E" TextAlignment="Center"
                                       Text="{x:Static properties:Resources.TextBlock_Login}" />
                        </Grid>

                        <TextBox x:Name="textBoxUsernameOrEmail" Grid.Row="2" Height="48"
                                 Tag="{x:Static properties:Resources.TextBox_UsernameOrEmail}"
                                 Style="{StaticResource LoginTextBoxStyle}" />

                        <Grid Grid.Row="4" Height="48">
                            <PasswordBox x:Name="passwordBoxPassword"
                                         PasswordChanged="OnPasswordChanged"
                                         Style="{StaticResource LoginPasswordBoxStyle}" />
                            <TextBlock x:Name="textBlockPasswordPlaceholder"
                                       Text="{x:Static properties:Resources.PasswordBox_Password}"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="#D2BFEF" FontFamily="Segoe UI" FontSize="16"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <Button x:Name="buttonSignIn" Grid.Row="6" Height="46"
                                Content="{x:Static properties:Resources.Button_SignIn}"
                                Style="{StaticResource SignInButtonStyle}"
                                Click="OnSignInClick" />

                        <StackPanel Grid.Row="8" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="{x:Static properties:Resources.TextBlock_DoNotHaveAnAccount}"
                                       VerticalAlignment="Center" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#D2BFEF" />
                            <Button x:Name="buttonSignUp"
                                    Content="{x:Static properties:Resources.Button_SignUp}"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SignUpLinkButtonStyle}"
                                    Click="OnButtonSignUpClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="{x:Static properties:Resources.Button_Back}"
                        Background="#080D1A" BorderBrush="#00C9F2" BorderThickness="2"
                        Foreground="#E795EC" FontSize="16" Cursor="Hand"
                        HorizontalAlignment="Left" Margin="750,400,0,0"
                        VerticalAlignment="Top" Width="100" Height="35"
                        Click="OnBackClick" />
            </Grid>
        </Viewbox>
    </Grid>
</Page>
