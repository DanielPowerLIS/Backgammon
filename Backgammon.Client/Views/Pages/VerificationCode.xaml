<Page x:Class="Backgammon.Client.Views.Pages.VerificationCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d"
      d:DesignHeight="480"
      d:DesignWidth="900"
      Title="VerificationCode">
    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush"
                             Center="0.5,0.5"
                             GradientOrigin="0.5,0.5"
                             RadiusX="0.65"
                             RadiusY="0.85">
            <GradientStop Color="#111B35" Offset="0" />
            <GradientStop Color="#090F1E" Offset="0.55" />
            <GradientStop Color="#040810" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonBackgroundBrush"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#21F0F5" Offset="0" />
            <GradientStop Color="#00CBE5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonHoverBrush"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#69FAFF" Offset="0" />
            <GradientStop Color="#16DCEF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonPressedBrush"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00BED4" Offset="0" />
            <GradientStop Color="#009DBB" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="NeonTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#EC99F4" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="VerificationDigitTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="MaxLength" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#00DAF0" />
            <Setter Property="Background" Value="#090F1E" />
            <Setter Property="Foreground" Value="#DDC5FA" />
            <Setter Property="CaretBrush" Value="#F3A1F5" />
            <Setter Property="SelectionBrush" Value="#087C98" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BorderInput"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderInput"
                                        Property="BorderBrush" Value="#91F9FF" />
                                <Setter TargetName="BorderInput" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00DFF5"
                                                          ShadowDepth="0"
                                                          BlurRadius="10"
                                                          Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderInput"
                                        Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerifyCodeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="{StaticResource NeonButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="#04121E" />
            <Setter Property="BorderBrush" Value="#8CF9FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#00DDF3"
                                                  ShadowDepth="0"
                                                  BlurRadius="18"
                                                  Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderButton"
                                        Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderButton"
                                        Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F29AF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"
                                       TextDecorations="Underline" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#CE69DD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="900" Height="480">
                <Border Width="430" Height="376"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#090F1E"
                        BorderBrush="#00E5F4"
                        BorderThickness="2"
                        CornerRadius="22">
                    <Grid Margin="36,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_VerificationCode}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_VerificationCode}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_VerificationCode}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_VerificationCode}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock FontFamily="Segoe UI" FontSize="26"
                                       FontWeight="Bold" Foreground="#090F1E"
                                       TextAlignment="Center"
                                       Text="{x:Static properties:Resources.TextBlock_VerificationCode}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Width="354" Margin="0,22,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#D2BFEF"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Text="{x:Static properties:Resources.TextBlock_VerificationCodeInstruction}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Margin="0,24,0,0"
                                    HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBox x:Name="textBoxDigit1"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                            <TextBox x:Name="textBoxDigit2"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                            <TextBox x:Name="textBoxDigit3"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                            <TextBox x:Name="textBoxDigit4"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                            <TextBox x:Name="textBoxDigit5"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                            <TextBox x:Name="textBoxDigit6"
                                     Style="{StaticResource VerificationDigitTextBoxStyle}" />
                        </StackPanel>
                        <Button x:Name="buttonVerifyCode" Grid.Row="3" Margin="0,32,0,0"
                                Content="{x:Static properties:Resources.Button_VerifyCode}"
                                Style="{StaticResource VerifyCodeButtonStyle}" />
                        <StackPanel Grid.Row="4" Margin="0,28,0,0"
                                    HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#D2BFEF"
                                       Text="{x:Static properties:Resources.TextBlock_DidNotReceiveCode}" />
                            <Button x:Name="buttonResend"
                                    Content="{x:Static properties:Resources.Button_Resend}"
                                    Style="{StaticResource ResendButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Page>