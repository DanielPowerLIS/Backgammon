<Page x:Class="Backgammon.Client.Views.Pages.VerificationCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="VerificationCode">

    <Page.Resources>
        <RadialGradientBrush
            x:Key="PageBackgroundBrush"
            Center="0.5,0.35"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop
                Color="#171C2B"
                Offset="0" />

            <GradientStop
                Color="#0C1220"
                Offset="0.55" />

            <GradientStop
                Color="#050914"
                Offset="1" />

        </RadialGradientBrush>
        
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both">

            <Grid
                Width="900"
                Height="450">

                <Border
                    Width="440"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F5F5F5"
                    CornerRadius="28">
                    
                    
                    
                </Border>
                
            </Grid>
            
        </Viewbox>
        
    </Grid>
    
</Page>
