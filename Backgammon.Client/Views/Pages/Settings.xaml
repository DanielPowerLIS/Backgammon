<Page x:Class="Backgammon.Client.Views.Pages.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        mc:Ignorable="d"
        d:DesignHeight="450"
        d:DesignWidth="800"
        Title="{x:Static properties:Resources.TextBlock_Button_Settings}" FontSize="50">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.TextBlock_Button_Settings}" HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PinkAccentBrush}" Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E795EC" BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Grid.Row="1" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="2" Background="{StaticResource ControlBackgroundBrush}" Padding="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Content="{x:Static properties:Resources.TextBlock_Button_Account}" Style="{StaticResource SettingsButtonStyle}" MinWidth="150" MinHeight="40" Margin="0,0,0,15"/>
                    <Button Content="{x:Static properties:Resources.TextBlock_Button_Language}" Style="{StaticResource SettingsButtonStyle}" MinWidth="150" MinHeight="40" Margin="0,0,0,15" Click="OnLanguageClick"/>
                    <Button Content="{x:Static properties:Resources.TextBlock_Button_ChangePassword}" Style="{StaticResource SettingsButtonStyle}" MinWidth="180" MinHeight="40"/>
                </StackPanel>
            </Border>

            <Button Grid.Row="2" Content="{x:Static properties:Resources.Button_Back}" Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource PinkAccentBrush}" MinWidth="100"  MinHeight="35" HorizontalAlignment="Right" Margin="0,15,0,0" Click="OnBackClick"/>
        </Grid>

    </Grid>

</Page>
