<Page x:Class="Backgammon.Client.Views.Pages.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        mc:Ignorable="d"
        Title="Settings" Height="450" Width="800" FontSize="50"
        Background="White">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="{x:Static properties:Resources.Settings}" VerticalAlignment="Top" FontSize="45"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="30,96,30,60">
            <StackPanel>
                <Button Content="{x:Static properties:Resources.Account}" Width="129" Height="29" Margin="0,10,0,10" FontSize="14"/>
                <Button Content="{x:Static properties:Resources.Language}" Width="130" Height="29" Margin="0,10,0,10" FontSize="14"/>
                <Button Content="{x:Static properties:Resources.ChangePassword}" Width="130" Height="29" FontSize="14" Margin="0,10,0,10"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
