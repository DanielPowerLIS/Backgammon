<Page x:Class="Backgammon.Client.Views.Pages.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static properties:Resources.MainMenu}">
    <Page.Resources>

        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>
        
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>
        
        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="176"/>
            <Setter Property="MinHeight"  Value="30"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="BACKGAMMON" HorizontalAlignment="Center" FontSize="45" Foreground="{StaticResource CyanAccentBrush}" Margin="0,10,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00C9F2" BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="{x:Static properties:Resources.buttonPlay}" Style="{StaticResource MainMenuButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{x:Static properties:Resources.Leaderboard}" Style="{StaticResource MainMenuButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{x:Static properties:Resources.Profile}" Style="{StaticResource MainMenuButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{x:Static properties:Resources.Friends}" Style="{StaticResource MainMenuButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{x:Static properties:Resources.Settings}" Style="{StaticResource MainMenuButtonStyle}"/>
            </StackPanel>
            
            <Button Grid.Row="2" Content="{x:Static properties:Resources.buttonSignOut}" Style="{StaticResource MainMenuButtonStyle}" MinWidth="100" HorizontalAlignment="Left" Margin="0,15,0,0"/>

        </Grid>

    </Grid>

</Page>
