<Page x:Class="Backgammon.Client.Views.Pages.FriendRequests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FriendRequests"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.FriendRequests}" HorizontalAlignment="Center" FontSize="30" Margin="0,15,0,0"/>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Padding="10">
            <ListView x:Name="FriendRequestList">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="70*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140*"/>
                                <ColumnDefinition Width="140*"/>

                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="40" Height="40" Fill="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Something" VerticalAlignment="Center" FontSize="16"/>
                            <Button Grid.Column="2" Content="{x:Static properties:Resources.Accept}" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="{x:Static properties:Resources.Reject}" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Button Grid.Row="2" Content="{x:Static properties:Resources.Back}" Width="100" Height="35" HorizontalAlignment="Right"  Margin="0,10,10,10"/>

    </Grid>
</Page>
