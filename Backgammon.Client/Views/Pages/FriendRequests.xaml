<Page x:Class="Backgammon.Client.Views.Pages.FriendRequests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FriendRequests">
    
    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5, 0.5" GradientOrigin="0.5, 0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0" />
            <GradientStop Color="#0C1220" Offset="0.55" />
            <GradientStop Color="#050914" Offset="1" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2" />
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC" />
        <Style x:Key="FriendRequestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.FriendRequests}" HorizontalAlignment="Center" FontSize="30" Margin="0,15,0,20" Foreground="{StaticResource PinkAccentBrush}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E795EC" BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Grid.Row="1" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="2" Padding="10" Margin="20,0,20,0">
                <ListView x:Name="FriendRequestList" Background="Transparent" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>

                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="40" Height="40" Fill="#3D7EA6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Something" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource CyanAccentBrush}"/>
                                <Button Grid.Column="2" Content="{x:Static properties:Resources.Accept}" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FriendRequestButtonStyle}"/>
                                <Button Grid.Column="3" Content="{x:Static properties:Resources.Reject}" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FriendRequestButtonStyle}"/>

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <Button Grid.Row="2" Content="{x:Static properties:Resources.Back}" Style ="{StaticResource FriendRequestButtonStyle}" Width="100" Height="35" HorizontalAlignment="Right"  Margin="0,15,20,10"/>

        </Grid>
    </Grid>
</Page>
