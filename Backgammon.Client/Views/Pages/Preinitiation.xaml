<Page x:Class="Backgammon.Client.Views.Pages.Preinitiation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static properties:Resources.TextBlock_Preinitiation}">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5, 0.5" GradientOrigin="0.5, 0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0" />
            <GradientStop Color="#0C1220" Offset="0.55" />
            <GradientStop Color="#050914" Offset="1" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2" />
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC" />
        <Style x:Key="PreinitiationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height"  Value="45"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"  Text="BACKGAMMON"  Foreground="{StaticResource CyanAccentBrush}"  HorizontalAlignment="Center"  VerticalAlignment="Top"  Margin="0,10,0,20"  FontFamily="Segoe UI"  FontSize="50"  TextAlignment="Center"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource PreinitiationButtonStyle}" Content="{x:Static properties:Resources.Button_CreateLobby}"  Click="OnCreateLobbyClick" />
                <Button Style="{StaticResource PreinitiationButtonStyle}" Content="{x:Static properties:Resources.Button_Join}" Click="OnJoinClick" />
            </StackPanel>
            
            <Button Grid.Row="2" Style="{StaticResource PreinitiationButtonStyle}" Content="{x:Static properties:Resources.Button_Back}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnBackClick" />
          
        </Grid>
    </Grid>
</Page>
