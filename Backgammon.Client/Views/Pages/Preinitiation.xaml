<Page x:Class="Backgammon.Client.Views.Pages.Preinitiation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Preinitiation"
      Background="White">

    <Grid>
        <Label Content="Backgammon" HorizontalAlignment="Center" Height="75" Margin="0,37,0,0" VerticalAlignment="Top" Width="288" FontSize="45"/>
        <Button Content="{x:Static properties:Resources.CreateLobby}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click" Width="176" Height="26"/>
        <Button Content="{x:Static properties:Resources.Join}" HorizontalAlignment="Center" Margin="0,284,0,0" VerticalAlignment="Top" Width="176" Height="26"/>
        <Button Content="{x:Static properties:Resources.Back}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click" Width="75" Height="20" Margin="28,388,0,0"/>

    </Grid>
</Page>
