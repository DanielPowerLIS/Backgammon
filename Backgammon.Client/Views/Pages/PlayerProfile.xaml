<Page x:Class="Backgammon.Client.Views.Pages.PlayerProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static properties:Resources.TextBlock_Button_Profile}">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>
        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid Grid.ColumnSpan="1">
            <Separator HorizontalAlignment="Left" Margin="44,221,0,0" VerticalAlignment="Top" Height="3" Width="420" Background="{StaticResource CyanAccentBrush}" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Grid.RowSpan="1">
                <Separator.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-89.986"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Separator.RenderTransform>
            </Separator>
            <Ellipse HorizontalAlignment="Left" Height="111" Margin="70,70,0,0" Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="2" VerticalAlignment="Top" Width="107" Fill="#3d7ea6">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.375"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Label Content="Nombre usuario" HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource PinkAccentBrush}" FontSize="20"/>
            <Label Content="ID" HorizontalAlignment="Left" Margin="50,310,0,0" VerticalAlignment="Top" FontSize="20" Foreground="{StaticResource PinkAccentBrush}"/>
            <Label Content="Label" HorizontalAlignment="Left" Margin="162,310,0,0" VerticalAlignment="Top" FontSize="20" Foreground="{StaticResource PinkAccentBrush}"/>
            <StackPanel Margin="283,10,10,23">

                <Grid Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_Points}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TxtPoints" Text="350" FontSize="20" Foreground="{StaticResource PinkAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.TextBlock_Wins}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" x:Name="TxtWins" Text="3" FontSize="20" Foreground="{StaticResource PinkAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <Grid Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_DateJoined}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TxtRegistrationDate" Text="08/26/2026" FontSize="20" Foreground="{StaticResource PinkAccentBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>

                <StackPanel Margin="0,5,0,10">
                    <TextBlock Text="{x:Static properties:Resources.TextBlock_Label_Description}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,5"/>
                    <Border BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="2" Background="{StaticResource ControlBackgroundBrush}" Padding="8">
                        <TextBlock x:Name="TxtDescription" Text="Apasionado del backgammon" Foreground="{StaticResource PinkAccentBrush}" FontSize="16" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.TextBlock_SocialMedia}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,5"/>

                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Facebook:" FontSize="18" Foreground="{StaticResource CyanAccentBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtFacebook" Text="https://facebook.com" FontSize="18" Foreground="{StaticResource PinkAccentBrush}" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="{x:Static properties:Resources.Button_AddLink}" Style="{StaticResource ProfileButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Instagram:" FontSize="18" Foreground="{StaticResource CyanAccentBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtInstagram" Text="https://instagram.com" FontSize="18" Foreground="{StaticResource PinkAccentBrush}" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="{x:Static properties:Resources.Button_AddLink}" Style="{StaticResource ProfileButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TikTok:" FontSize="18" Foreground="{StaticResource CyanAccentBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTikTok" Text="Sin enlace" FontSize="18" Foreground="{StaticResource PinkAccentBrush}"/>
                        <Button Grid.Column="2" Content="{x:Static properties:Resources.Button_AddLink}" Style="{StaticResource ProfileButtonStyle}"  Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <Button Content="{x:Static properties:Resources.Button_Back}" Style="{StaticResource ProfileButtonStyle}"  Width="100"  Height="35" HorizontalAlignment="Right" Margin="0,15,0,0"/>

            </StackPanel>
        </Grid>

    </Grid>
</Page>
