<Page x:Class="Backgammon.Client.Views.Pages.PlayerProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="{x:Static properties:Resources.TextBlock_Button_Profile}">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush"
                             Center="0.5,0.5"
                             GradientOrigin="0.5,0.35"
                             RadiusX="0.85"
                             RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#080D1A"/>

        <SolidColorBrush x:Key="CyanAccentBrush"
                         Color="#00C9F2"/>

        <SolidColorBrush x:Key="PinkAccentBrush"
                         Color="#E795EC"/>

        <Style x:Key="ProfileButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Padding"
                    Value="8,4"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Viewbox Stretch="Uniform">

            <Grid Width="800"
                  Height="450">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Row="0"
                             Width="107"
                             Height="111"
                             Margin="0,50,0,15"
                             HorizontalAlignment="Center"
                             Stroke="{StaticResource CyanAccentBrush}"
                             StrokeThickness="2"
                             Fill="#3D7EA6"/>

                    <TextBlock Grid.Row="1"
                               Text="Nombre usuario"
                               FontSize="20"
                               Foreground="{StaticResource PinkAccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5"/>

                    <Grid Grid.Row="2"
                          Margin="40,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ID"
                                   FontSize="20"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Label"
                                   FontSize="20"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Grid>

                <Border Grid.Column="1"
                        Background="{StaticResource CyanAccentBrush}"
                        Margin="0,35"/>

                <Grid Grid.Column="2"
                      Margin="30,20,30,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Height="50">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Static properties:Resources.TextBlock_Points}"
                                   FontSize="20"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="textBlockPoints"
                                   Text="350"
                                   FontSize="20"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Static properties:Resources.TextBlock_Wins}"
                                   FontSize="20"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   x:Name="textBlockWins"
                                   Text="3"
                                   FontSize="20"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>

                    </Grid>

                    <Grid Grid.Row="1"
                          Height="50">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Static properties:Resources.TextBlock_DateJoined}"
                                   FontSize="20"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="textBlockRegistrationDate"
                                   Text="08/26/2026"
                                   FontSize="20"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>

                    </Grid>

                    <StackPanel Grid.Row="2"
                                Margin="0,5,0,10">

                        <TextBlock Text="{x:Static properties:Resources.TextBlock_Label_Description}"
                                   FontSize="20"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   Margin="0,0,0,5"/>

                        <Border BorderBrush="{StaticResource CyanAccentBrush}"
                                BorderThickness="2"
                                Background="{StaticResource ControlBackgroundBrush}"
                                Padding="8">

                            <TextBlock x:Name="textBlockDescription"
                                       Text="Apasionado del backgammon"
                                       Foreground="{StaticResource PinkAccentBrush}"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Row="3">

                        <TextBlock Text="{x:Static properties:Resources.TextBlock_SocialMedia}"
                                   FontSize="20"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   Margin="0,0,0,5"/>

                        <Grid Margin="0,3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Facebook:"
                                       FontSize="18"
                                       Foreground="{StaticResource CyanAccentBrush}"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="textBlockFacebook"
                                       Text="https://facebook.com"
                                       FontSize="18"
                                       Foreground="{StaticResource PinkAccentBrush}"
                                       TextWrapping="Wrap"/>

                            <Button Grid.Column="2"
                                    Content="{x:Static properties:Resources.Button_AddLink}"
                                    Style="{StaticResource ProfileButtonStyle}"
                                    Margin="8,0,0,0"/>

                        </Grid>

                        <Grid Margin="0,3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Instagram:"
                                       FontSize="18"
                                       Foreground="{StaticResource CyanAccentBrush}"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="textBlockInstagram"
                                       Text="https://instagram.com"
                                       FontSize="18"
                                       Foreground="{StaticResource PinkAccentBrush}"
                                       TextWrapping="Wrap"/>

                            <Button Grid.Column="2"
                                    Content="{x:Static properties:Resources.Button_AddLink}"
                                    Style="{StaticResource ProfileButtonStyle}"
                                    Margin="8,0,0,0"/>

                        </Grid>

                        <Grid Margin="0,3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="TikTok:"
                                       FontSize="18"
                                       Foreground="{StaticResource CyanAccentBrush}"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="textBlockTikTok"
                                       Text="Sin enlace"
                                       FontSize="18"
                                       Foreground="{StaticResource PinkAccentBrush}"/>

                            <Button Grid.Column="2"
                                    Content="{x:Static properties:Resources.Button_AddLink}"
                                    Style="{StaticResource ProfileButtonStyle}"
                                    Margin="8,0,0,0"/>

                        </Grid>

                    </StackPanel>

                    <Button Grid.Row="4"
                            Content="{x:Static properties:Resources.Button_Back}"
                            Style="{StaticResource ProfileButtonStyle}"
                            Width="100"
                            Height="35"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Click="OnBackClick"/>
                </Grid>

            </Grid>

        </Viewbox>

    </Grid>

</Page>