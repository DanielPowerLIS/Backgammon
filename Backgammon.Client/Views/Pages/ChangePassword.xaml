<Page x:Class="Backgammon.Client.Views.Pages.ChangePassword"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="{x:Static properties:Resources.TextBlock_Button_ChangePassword}">

    <Page.Resources>
        <RadialGradientBrush
            x:Key="PageBackgroundBrush"
            Center="0.5,0.35"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop
                Color="#171C2B"
                Offset="0" />

            <GradientStop
                Color="#0C1220"
                Offset="0.55" />

            <GradientStop
                Color="#050914"
                Offset="1" />

        </RadialGradientBrush>

        <Style
            x:Key="ChangePasswordBoxStyle"
            TargetType="PasswordBox">

            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="#17B8B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="ChangePasswordButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="#17B8B1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#20CBC3" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#109A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BackButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="#9B9CA1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#ADADB1" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#85868B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both">

            <Grid
                Width="900"
                Height="450">
                <Border
                    Width="440"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F5F5F5"
                    CornerRadius="28">

                    <Grid Margin="55,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock
        Grid.Row="0"
        Text="{x:Static properties:Resources.TextBlock_Button_ChangePassword}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontFamily="Segoe UI"
        FontSize="22"
        FontWeight="Bold"
        Foreground="#202020" />

                        <Grid Grid.Row="2">
                            <PasswordBox
                                x:Name="passwordBoxCurrentPassword"
                                PasswordChanged="OnCurrentPasswordChanged"
                                Style="{StaticResource ChangePasswordBoxStyle}" />

                            <TextBlock
                                x:Name="textBlockCurrentPasswordPlaceholder"
                                Text="{x:Static properties:Resources.PasswordBox_CurrentPassword}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#7D7D7D"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <PasswordBox
                                x:Name="passwordBoxNewPassword"
                                PasswordChanged="OnNewPasswordChanged"
                                Style="{StaticResource ChangePasswordBoxStyle}" />

                            <TextBlock
                                x:Name="textBlockNewPasswordPlaceholder"
                                Text="{x:Static properties:Resources.PasswordBox_NewPassword}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#7D7D7D"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Row="6">
                            <PasswordBox
                                x:Name="passwordBoxConfirmPassword"
                                PasswordChanged="OnConfirmPasswordChanged"
                                Style="{StaticResource ChangePasswordBoxStyle}" />

                            <TextBlock
                                x:Name="textBlockConfirmPasswordPlaceholder"
                                Text="{x:Static properties:Resources.PasswordBox_ConfirmPassword}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#7D7D7D"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False" />
                        </Grid>

                        <Button
                            x:Name="buttonChangePassword"
                            Grid.Row="8"
                            Content="{x:Static properties:Resources.TextBlock_Button_ChangePassword}"
                            Style="{StaticResource ChangePasswordButtonStyle}" />

                        <Button
                            x:Name="buttonBack"
                            Grid.Row="10"
                            Content="{x:Static properties:Resources.Button_Back}"
                            Style="{StaticResource BackButtonStyle}" />
                    </Grid>

                </Border>
                
                
            </Grid>
            
        </Viewbox>
    </Grid>
    
</Page>
