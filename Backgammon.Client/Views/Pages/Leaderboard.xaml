<Page x:Class="Backgammon.Client.Views.Pages.Leaderboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="{x:Static properties:Resources.TextBlock_Button_Leaderboard}">

    <Page.Resources>

        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>
        <Style x:Key="LeaderboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.TextBlock_Button_Leaderboard}" HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PinkAccentBrush}" Margin="0,0,0,20">

                <TextBlock.Effect>
                    <DropShadowEffect Color="#E795EC" BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>

            </TextBlock>

            <Border Grid.Row="1" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="2" Background="{StaticResource ControlBackgroundBrush}" Padding="10">
                <ListBox x:Name="LeaderboardListBox"
             Background="Transparent"
             BorderThickness="0">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                             Width="40"
                             Height="40"
                             Fill="#3D7EA6"
                             HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                               Text="{Binding Username}"
                               FontSize="18"
                               Foreground="{StaticResource CyanAccentBrush}"
                               VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Static properties:Resources.TextBlock_Wins}"
                                   FontSize="14"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Wins}"
                                   FontSize="18"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Static properties:Resources.TextBlock_Points}"
                                   FontSize="14"
                                   Foreground="{StaticResource PinkAccentBrush}"
                                   HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Points}"
                                   FontSize="18"
                                   Foreground="{StaticResource CyanAccentBrush}"
                                   HorizontalAlignment="Center"/>
                                </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Border>

            <Button Grid.Row="2" Content="{x:Static properties:Resources.Button_Back}" Style="{StaticResource LeaderboardButtonStyle}" Width="100" Height="35" HorizontalAlignment="Right" Margin="0,15,0,0" Click="OnBackClick"/>
        </Grid>

    </Grid>

</Page>