<Page x:Class="Backgammon.Client.Views.Pages.Room"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Room"
      Background="White">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="100" Height="100" BorderBrush="Black" BorderThickness="1">
                    <Image x:Name="ImgHost"/>
                </Border>
                <TextBlock x:Name="TxtHostUsername" Text="Jugador1" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Border Width="100" Height="25" BorderBrush="Black" BorderThickness="1" CornerRadius="15" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtHostStatus" Text="Listo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="100" Height="100" BorderBrush="Black" BorderThickness="1">
                    <Image x:Name="ImgGuest"/>
                </Border>
                <TextBlock x:Name="TxtGuestUsername" Text="Jugador2" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Border Width="100" Height="25" BorderBrush="Black" BorderThickness="1" CornerRadius="15" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtGuestStatus" Text="Listo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <Button Content="{x:Static properties:Resources.LeaveRoom}" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10" Width="100" Height="30" FontSize="15"/>
            <Button Content="{x:Static properties:Resources.OpenChat}" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10" Width="100" Height="30" FontSize="15"/>
            <Button Content="{x:Static properties:Resources.StartGame}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,10,10,10" Width="100" Height="30" FontSize="15"/>
        </Grid>

    </Grid>
</Page>
