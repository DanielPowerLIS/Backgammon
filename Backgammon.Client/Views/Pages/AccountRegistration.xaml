<Page x:Class="Backgammon.Client.Views.Pages.AccountRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="900"
      Title="{x:Static properties:Resources.TextBlock_AccountRegistration}">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.65" RadiusY="0.85">
            <GradientStop Color="#111B35" Offset="0" />
            <GradientStop Color="#090F1E" Offset="0.55" />
            <GradientStop Color="#040810" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="NeonButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#21F0F5" Offset="0" />
            <GradientStop Color="#00CBE5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#69FAFF" Offset="0" />
            <GradientStop Color="#16DCEF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00BED4" Offset="0" />
            <GradientStop Color="#009DBB" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="NeonTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#EC99F4" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="RegistrationTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#090F1E" />
            <Setter Property="BorderBrush" Value="#00DAF0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#DDC5FA" />
            <Setter Property="CaretBrush" Value="#F3A1F5" />
            <Setter Property="SelectionBrush" Value="#087C98" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BorderInput"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="textBlockPlaceholder"
                                           Text="{Binding Tag,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               StringFormat='{}{0} *'}"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#D2BFEF"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="textBlockPlaceholder"
                                        Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderInput"
                                        Property="BorderBrush" Value="#91F9FF" />
                                <Setter TargetName="BorderInput" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00DFF5" ShadowDepth="0"
                                                          BlurRadius="10" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderInput" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegistrationPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#090F1E" />
            <Setter Property="BorderBrush" Value="#00DAF0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#DDC5FA" />
            <Setter Property="CaretBrush" Value="#F3A1F5" />
            <Setter Property="SelectionBrush" Value="#087C98" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="BorderInput"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderInput"
                                        Property="BorderBrush" Value="#91F9FF" />
                                <Setter TargetName="BorderInput" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00DFF5" ShadowDepth="0"
                                                          BlurRadius="10" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderInput" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateAccountButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NeonButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="#04121E" />
            <Setter Property="BorderBrush" Value="#8CF9FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#00DDF3" ShadowDepth="0"
                                                  BlurRadius="18" Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BorderButton" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderButton" Property="Background"
                                        Value="{StaticResource NeonButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BorderButton" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignInLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F29AF3" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#CE69DD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="900" Height="480">
                <Border Width="440" Height="438"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#090F1E" BorderBrush="#00E5F4"
                        BorderThickness="2" CornerRadius="20">
                    <Grid Margin="32,20,32,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <!-- Offset text layers approximate the prototype's neon outline. -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="-1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Style="{StaticResource NeonTitleTextStyle}"
                                       Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="1" Y="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                       Foreground="#090F1E" TextAlignment="Center"
                                       Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}" />
                        </Grid>

                        <TextBox x:Name="textBoxEmail" Grid.Row="2"
                                 Tag="{x:Static properties:Resources.TextBox_EmailAddress}"
                                 Style="{StaticResource RegistrationTextBoxStyle}" />
                        <TextBox x:Name="textBoxFirstName" Grid.Row="4"
                                 Tag="{x:Static properties:Resources.TextBox_FirstName}"
                                 Style="{StaticResource RegistrationTextBoxStyle}" />

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="textBoxPaternalLastName" Grid.Column="0"
                                     Tag="{x:Static properties:Resources.TextBox_PaternalLastName}"
                                     Style="{StaticResource RegistrationTextBoxStyle}" />
                            <TextBox x:Name="textBoxMaternalLastName" Grid.Column="2"
                                     Tag="{x:Static properties:Resources.TextBox_MaternalLastName}"
                                     Style="{StaticResource RegistrationTextBoxStyle}" />
                        </Grid>

                        <TextBox x:Name="textBoxUsername" Grid.Row="8"
                                 Tag="{x:Static properties:Resources.TextBox_Username}"
                                 Style="{StaticResource RegistrationTextBoxStyle}" />

                        <Grid Grid.Row="10">
                            <PasswordBox x:Name="passwordBoxPassword"
                                         Style="{StaticResource RegistrationPasswordBoxStyle}"
                                         PasswordChanged="OnPasswordChanged" />
                            <TextBlock x:Name="textBlockPasswordPlaceholder"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="#D2BFEF" FontFamily="Segoe UI" FontSize="14"
                                       IsHitTestVisible="False"
                                       Text="{Binding Source={x:Static properties:Resources.PasswordBox_Password},
                                           StringFormat='{}{0} *'}" />
                        </Grid>

                        <Button x:Name="buttonCreateAccount" Grid.Row="12"
                                Content="{x:Static properties:Resources.Button_CreateAccount}"
                                Style="{StaticResource CreateAccountButtonStyle}"
                                Click="OnCreateAccountClick" />

                        <StackPanel Grid.Row="14" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="textBlockAlreadyHaveAccount"
                                       VerticalAlignment="Center" Foreground="#D2BFEF"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Text="{x:Static properties:Resources.TextBlock_AlreadyHaveAccount}" />
                            <Button x:Name="buttonSignIn" Margin="6,0,0,0"
                                    Content="{x:Static properties:Resources.Button_SignIn}"
                                    Style="{StaticResource SignInLinkButtonStyle}"
                                    Click="OnButtonSignInClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Page>