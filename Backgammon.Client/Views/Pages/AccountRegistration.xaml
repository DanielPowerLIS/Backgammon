<Page x:Class="Backgammon.Client.Views.Pages.AccountRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="{x:Static properties:Resources.TextBlock_AccountRegistration}">

    <Page.Resources>
        <RadialGradientBrush
            x:Key="PageBackgroundBrush"
            Center="0.5,0.35"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop
                Color="#171C2B"
                Offset="0" />

            <GradientStop
                Color="#0C1220"
                Offset="0.55" />

            <GradientStop
                Color="#050914"
                Offset="1" />

        </RadialGradientBrush>

        <Style
            x:Key="RegistrationTextBoxStyle"
            TargetType="TextBox">

            <Setter
                Property="Background"
                Value="#FAFAFA" />

            <Setter
                Property="BorderBrush"
                Value="#999999" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Foreground"
                Value="#202020" />

            <Setter
                Property="CaretBrush"
                Value="#202020" />

            <Setter
                Property="FontFamily"
                Value="Segoe UI" />

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="Padding"
                Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="BorderInput"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="textBlockPlaceholder"
                                    Text="{Binding Tag,
                                       RelativeSource={RelativeSource TemplatedParent},
                                       StringFormat='{}{0} *'}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#7D7D7D"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="Text"
                                Value="">

                                <Setter
                                    TargetName="textBlockPlaceholder"
                                    Property="Visibility"
                                    Value="Visible" />
                            </Trigger>

                            <Trigger
                                Property="IsKeyboardFocused"
                                Value="True">

                                <Setter
                                    TargetName="BorderInput"
                                    Property="BorderBrush"
                                    Value="#17B8B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="RegistrationPasswordBoxStyle"
            TargetType="PasswordBox">

            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="BorderInput"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderInput"
                                    Property="BorderBrush"
                                    Value="#17B8B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CreateAccountButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="#17B8B1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BorderButton"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#20CBC3" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#109A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SignInLinkButtonStyle"
            TargetType="Button">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#17B8B1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#109A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both">
            
            <Grid
                Width="900"
                Height="450">

                <Border
                    Width="440"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F5F5F5"
                    CornerRadius="28">

                    <Grid Margin="55,20,55,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="{x:Static properties:Resources.TextBlock_CreateAnAccount}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#191919"
                            FontFamily="Segoe UI"
                            FontSize="22"
                            FontWeight="Bold"
                            TextAlignment="Center" />

                        <TextBox
                            x:Name="textBoxEmail"
                            Grid.Row="2"
                            Tag="{x:Static properties:Resources.TextBox_EmailAddress}"
                            Style="{StaticResource RegistrationTextBoxStyle}" />

                        <TextBox
                            x:Name="textBoxFirstName"
                            Grid.Row="4"
                            Tag="{x:Static properties:Resources.TextBox_FirstName}"
                            Style="{StaticResource RegistrationTextBoxStyle}" />

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="textBoxPaternalLastName"
                                Grid.Column="0"
                                Tag="{x:Static properties:Resources.TextBox_PaternalLastName}"
                                Style="{StaticResource RegistrationTextBoxStyle}" />

                            <TextBox
                                x:Name="textBoxMaternalLastName"
                                Grid.Column="2"
                                Tag="{x:Static properties:Resources.TextBox_MaternalLastName}"
                                Style="{StaticResource RegistrationTextBoxStyle}" />
                        </Grid>

                        <TextBox
                            x:Name="textBoxUsername"
                            Grid.Row="8"
                            Tag="{x:Static properties:Resources.TextBox_Username}"
                            Style="{StaticResource RegistrationTextBoxStyle}" />

                        <Grid Grid.Row="10">
                            <PasswordBox
                                x:Name="passwordBoxPassword"
                                Style="{StaticResource RegistrationPasswordBoxStyle}"
                                PasswordChanged="OnPasswordChanged" />

                            <TextBlock
                                x:Name="textBlockPasswordPlaceholder"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#7D7D7D"
                                IsHitTestVisible="False"
                                Text="{Binding Source={x:Static properties:Resources.PasswordBox_Password},
                                    StringFormat='{}{0} *'}" />

                           
                        </Grid>
                        <Button
                             x:Name="buttonCreateAccount"
                             Grid.Row="12"
                             Content="{x:Static properties:Resources.Button_CreateAccount}"
                             Style="{StaticResource CreateAccountButtonStyle}"
                             Click="OnCreateAccountClick"/>

                        <StackPanel
                            Grid.Row="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                x:Name="textBlockAlreadyHaveAccount"
                                VerticalAlignment="Center"
                                Foreground="#7D8494"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                Text="{x:Static properties:Resources.TextBlock_AlreadyHaveAccount}" />

                            <Button
                                x:Name="buttonSignIn"
                                Margin="6,0,0,0"
                                Content="{x:Static properties:Resources.Button_SignIn}"
                                Style="{StaticResource SignInLinkButtonStyle}" 
                                Click="OnButtonSignInClick"/>
                        </StackPanel>
                    </Grid>

                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
