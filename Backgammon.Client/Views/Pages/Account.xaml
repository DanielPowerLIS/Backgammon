<Page x:Class="Backgammon.Client.Views.Pages.Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client.Views.Pages"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static properties:Resources.TextBlock_Button_Account}"
      Background="White">

    <Page.Resources>
        <RadialGradientBrush x:Key="PageBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#171C2B" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#050914" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>

        <Style x:Key="AccountButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize"  Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.TextBlock_Button_Account}" FontSize="30" Foreground="{StaticResource PinkAccentBrush}" HorizontalAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E795EC" BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Grid.Row="1" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="2" Background="{StaticResource ControlBackgroundBrush}" Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_LinkedEmail}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}"
                               Margin="0,10,20,10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtEmail" Text="jdaniel070905@gmail.com" FontSize="20" Foreground="{StaticResource PinkAccentBrush}"
                               Margin="0,10,0,10" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_DateJoined}" FontSize="20" Foreground="{StaticResource CyanAccentBrush}"
                               Margin="0,10,20,10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRegistrationDate" Text="08/26/2026" FontSize="20" Foreground="{StaticResource PinkAccentBrush}"
                               Margin="0,10,0,10" VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <Button Grid.Row="2"  Content="{x:Static properties:Resources.Button_Back}" Style="{StaticResource AccountButtonStyle}" Width="100" Height="35"
                    HorizontalAlignment="Right" Margin="0,15,0,0"/>
        </Grid>

    </Grid>
</Page>
