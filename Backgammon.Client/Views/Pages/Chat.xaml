<Window x:Class="Backgammon.Client.Views.Pages.Chat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="Chat"
        Width="820"
        Height="500"
        MinWidth="720"
        MinHeight="420"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#080D1A"/>
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00C9F2"/>
        <SolidColorBrush x:Key="PinkAccentBrush" Color="#E795EC"/>

        <Style x:Key="ChatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ChatBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="MessageInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ChatBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PinkAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="MessageListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource ChatBackgroundBrush}"
            BorderBrush="{StaticResource CyanAccentBrush}"
            BorderThickness="2"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="CHAT"
                           Foreground="{StaticResource PinkAccentBrush}"
                           FontSize="32"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{x:Static properties:Resources.Button_Back}"
                        Style="{StaticResource ChatButtonStyle}"
                        Click="OnBackToLobby"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="#050914"
                    BorderBrush="{StaticResource CyanAccentBrush}"
                    BorderThickness="2"
                    Padding="16">
                <ListBox x:Name="listBoxMessages"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource CyanAccentBrush}"
                         FontSize="18"
                         ItemContainerStyle="{StaticResource MessageListItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="textBoxMessage"
                         Grid.Column="0"
                         Style="{StaticResource MessageInputStyle}"
                         MaxLength="500"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Mensaje"
                         KeyDown="OnMessageKeyDown"/>

                <Button Grid.Column="1"
                        Content="{x:Static properties:Resources.Button_SendMessage}"
                        Style="{StaticResource ChatButtonStyle}"
                        Margin="10,0,0,0"
                        Click="OnSendMessage"/>
            </Grid>
        </Grid>
    </Border>
</Window>
