<Window x:Class="Backgammon.Client.Views.Dialog.DiceRollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backgammon.Client.Views.Dialog"
        xmlns:controls="clr-namespace:Backgammon.Client.Views.Game.Controls"
        mc:Ignorable="d"
        Title="Tirar dados" Height="280" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#171c2b">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="RollStatusText" Text="Tirando dados..." Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="15, 0" >
                <controls:DieControl x:Name="FirstDie"/>
                <TextBlock x:Name="FirstDieValueText" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,8, 0, 0"/>
            </StackPanel>
            <StackPanel Margin="15, 0" >
                <controls:DieControl x:Name="SecondDie"/>
                <TextBlock x:Name="SecondDieValueText" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,8, 0, 0"/>
            </StackPanel>
        </StackPanel>
        <Button x:Name="ContinueButton" Content="Continuar" Width="120" Height="40" Margin="0,25,0,0" IsEnabled="False" Click="OnContinueButtonClick" />
    </StackPanel>
</Window>
