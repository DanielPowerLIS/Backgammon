<Window
    x:Class="Backgammon.Client.Views.Dialog.DiceRollDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Backgammon.Client.Views.Game.Controls"
    xmlns:properties="clr-namespace:Backgammon.Client.Properties"
    Title="{x:Static properties:Resources.Title_OpeningRoll}"
    Width="480"
    Height="380"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="False"
    Background="#171C2B">

    <StackPanel
        Margin="24"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">

        <TextBlock
            x:Name="textBlockRollStatus"
            Text="{x:Static properties:Resources.Message_OpeningRollReady}"
            Foreground="White"
            FontSize="22"
            FontWeight="Bold"
            TextAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="420"
            Margin="0,0,0,20"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <StackPanel Margin="20,0">
                <TextBlock
                    Text="{x:Static properties:Resources.Label_OpeningRollHost}"
                    Foreground="#00C9F2"
                    FontSize="18"
                    TextAlignment="Center"
                    Margin="0,0,0,10"/>

                <controls:DieControl
                    x:Name="dieControlFirst"
                    Width="90"
                    Height="90"
                    DieColor="Blue"
                    Visibility="Hidden"/>

                <TextBlock
                    x:Name="textBlockFirstDieValue"
                    Text="—"
                    Foreground="White"
                    FontSize="20"
                    TextAlignment="Center"
                    Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Margin="20,0">
                <TextBlock
                    Text="{x:Static properties:Resources.Label_OpeningRollGuest}"
                    Foreground="#E795EC"
                    FontSize="18"
                    TextAlignment="Center"
                    Margin="0,0,0,10"/>

                <controls:DieControl
                    x:Name="dieControlSecond"
                    Width="90"
                    Height="90"
                    DieColor="Pink"
                    Visibility="Hidden"/>

                <TextBlock
                    x:Name="textBlockSecondDieValue"
                    Text="—"
                    Foreground="White"
                    FontSize="20"
                    TextAlignment="Center"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,24,0,0">

            <Button
                x:Name="buttonRollDie"
                Content="{x:Static properties:Resources.Button_RollDie}"
                Width="140"
                Height="40"
                Margin="5"
                IsEnabled="False"/>

            <Button
                x:Name="buttonContinue"
                Content="{x:Static properties:Resources.Button_Continue}"
                Width="140"
                Height="40"
                Margin="5"
                IsEnabled="False"
                Click="OnContinueButtonClick"/>
        </StackPanel>
    </StackPanel>
</Window>