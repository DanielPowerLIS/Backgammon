<Window x:Class="Backgammon.Client.Views.Dialog.AddSocialLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="{x:Static properties:Resources.Button_AddLink}"
        Width="390"
        MinHeight="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=textBoxLink}">

    <Window.Resources>
        <RadialGradientBrush
            x:Key="DialogBackgroundBrush"
            Center="0.5,0.5"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop Color="#171C2B" Offset="0" />
            <GradientStop Color="#0C1220" Offset="0.55" />
            <GradientStop Color="#050914" Offset="1" />
        </RadialGradientBrush>

        <SolidColorBrush
            x:Key="CyanAccentBrush"
            Color="#00C9F2" />

        <SolidColorBrush
            x:Key="PinkAccentBrush"
            Color="#E795EC" />

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#080D1A" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#173044" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#22465A" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#080D1A" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="CaretBrush"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10,5" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">

                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="Placeholder"
                                    Text="{TemplateBinding Tag}"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PinkAccentBrush}"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter
                                    TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="18,12,18,16"
        Background="{StaticResource DialogBackgroundBrush}"
        BorderBrush="{StaticResource CyanAccentBrush}"
        BorderThickness="2"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    x:Name="textBlockTitle"
                    Margin="30,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource CyanAccentBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <TextBlock
                x:Name="textBlockLinkLabel"
                Grid.Row="1"
                Margin="0,0,0,5"
                FontFamily="Segoe UI"
                FontSize="16"
                Foreground="{StaticResource CyanAccentBrush}" />

            <TextBox
                x:Name="textBoxLink"
                Grid.Row="2"
                Style="{StaticResource LinkTextBoxStyle}" />

            <TextBlock
                Grid.Row="3"
                Margin="0,6,0,12"
                Text="{x:Static properties:Resources.TextBlock_SocialLinkLimitMessage}"
                FontFamily="Segoe UI"
                FontSize="12"
                Foreground="{StaticResource CyanAccentBrush}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="buttonSave"
                    Grid.Column="0"
                    Content="{x:Static properties:Resources.Button_Save}"
                    Style="{StaticResource DialogButtonStyle}"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="OnSaveClick" />

                <Button
                    x:Name="buttonCancel"
                    Grid.Column="2"
                    Content="{x:Static properties:Resources.Button_Cancel}"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
