<Window x:Class="Backgammon.Client.Views.Dialog.SelectSocialNetworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="{x:Static properties:Resources.TextBlock_AddSocialNetworkTitle}"
        Width="360"
        MinHeight="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush
            x:Key="DialogBackgroundBrush"
            Color="#080D1A" />

        <SolidColorBrush
            x:Key="CyanAccentBrush"
            Color="#00C9F2" />

        <SolidColorBrush
            x:Key="PinkAccentBrush"
            Color="#E795EC" />

        <Style x:Key="SocialNetworkButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background"
                    Value="{StaticResource DialogBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BorderButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#173044" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#22465A" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#19212B" />

                                <Setter
                                    TargetName="BorderButton"
                                    Property="BorderBrush"
                                    Value="#697589" />

                                <Setter
                                    Property="Foreground"
                                    Value="#718A9A" />

                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="22,14,22,12"
        Background="{StaticResource DialogBackgroundBrush}"
        BorderBrush="{StaticResource CyanAccentBrush}"
        BorderThickness="2"
        CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="22,6,22,0"
                    Text="{x:Static properties:Resources.TextBlock_AddSocialNetworkTitle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PinkAccentBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="buttonClose"
                    Width="26"
                    MinHeight="26"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="×"
                    FontSize="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Style="{StaticResource SocialNetworkButtonStyle}"
                    ToolTip="{x:Static properties:Resources.Button_Close}"
                    AutomationProperties.Name="{x:Static properties:Resources.Button_Close}"
                    Click="OnCloseClick" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,12"
                Text="{x:Static properties:Resources.TextBlock_SelectSocialNetworkMessage}"
                FontFamily="Segoe UI"
                FontSize="17"
                Foreground="{StaticResource CyanAccentBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" Margin="6,0,6,4">
                <ScrollViewer
                    MaxHeight="260"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="itemsControlNetworks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    IsEnabled="{Binding IsAvailable}"
                                    Style="{StaticResource SocialNetworkButtonStyle}"
                                    Click="OnNetworkClick">

                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            TextAlignment="Center" />

                                        <TextBlock
                                            Text="{x:Static properties:Resources.TextBlock_SocialNetworkAlreadyAdded}"
                                            FontSize="11"
                                            FontWeight="Normal"
                                            Foreground="#A696B5"
                                            TextAlignment="Center">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding HasLink}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Margin="0,12"
                    Text="{x:Static properties:Resources.TextBlock_NoSocialNetworksAvailableMessage}"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    Foreground="{StaticResource PinkAccentBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasItems,
                                        ElementName=itemsControlNetworks}"
                                    Value="False">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button
                x:Name="buttonCancel"
                Grid.Row="3"
                MinHeight="36"
                Margin="0,2,0,0"
                Content="{x:Static properties:Resources.Button_Cancel}"
                Foreground="{StaticResource PinkAccentBrush}"
                FontSize="15"
                Style="{StaticResource SocialNetworkButtonStyle}"
                IsCancel="True" />
        </Grid>
    </Border>
</Window>