<Window x:Class="Backgammon.Client.Views.Dialog.FriendProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="{x:Static properties:Resources.TextBlock_PlayerProfileTitle}"
        Width="480"
        MinHeight="245"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush
            x:Key="DialogBackgroundBrush"
            Color="#080D1A" />

        <SolidColorBrush
            x:Key="CyanAccentBrush"
            Color="#00C9F2" />

        <SolidColorBrush
            x:Key="PinkAccentBrush"
            Color="#E795EC" />

        <Style
            x:Key="FriendProfileButtonStyle"
            TargetType="Button">

            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background"
                    Value="{StaticResource DialogBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BorderButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#173044" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#22465A" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Opacity"
                                    Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="20,16,20,14"
        Background="{StaticResource DialogBackgroundBrush}"
        BorderBrush="{StaticResource CyanAccentBrush}"
        BorderThickness="2"
        CornerRadius="30">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,8"
                Text="{x:Static properties:Resources.TextBlock_PlayerProfileTitle}"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource CyanAccentBrush}" />

            <Grid
                Grid.Row="1"
                MinHeight="144"
                Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Width="132"
                    Height="132"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

                    <Ellipse
                        Fill="{StaticResource DialogBackgroundBrush}"
                        Stroke="{StaticResource CyanAccentBrush}"
                        StrokeThickness="2" />

                    <Ellipse Margin="12">
                        <Ellipse.Fill>
                            <ImageBrush
                                x:Name="avatarBrush"
                                Stretch="Uniform" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <TextBlock
                    x:Name="textBlockUsername"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PinkAccentBrush}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="buttonSendRequest"
                    Grid.Column="0"
                    MinWidth="180"
                    Content="{x:Static properties:Resources.Button_SendFriendRequest}"
                    Style="{StaticResource FriendProfileButtonStyle}"
                    IsDefault="True"
                    Click="OnSendRequestClick" />

                <Button
                    x:Name="buttonClose"
                    Grid.Column="2"
                    MinWidth="100"
                    Content="{x:Static properties:Resources.Button_Close}"
                    Style="{StaticResource FriendProfileButtonStyle}"
                    IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>