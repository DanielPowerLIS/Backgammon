<Window x:Class="Backgammon.Client.Views.Dialog.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Width="800" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid Background="#88000000">
        <Border Width="370" Height="190"
                Background="#FAFAFA"
                CornerRadius="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid Margin="26,25,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="textBlockHeading"
                           Grid.Row="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#202020"
                           TextAlignment="Center"/>

                <TextBlock x:Name="textBlockMessage"
                           Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#777777"
                           FontSize="13"/>

                <Button x:Name="buttonClose"
                        Content="{x:Static properties:Resources.Button_Close}"
                        Grid.Row="2"
                        Height="28"
                        Width="245"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Background="#929297"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>