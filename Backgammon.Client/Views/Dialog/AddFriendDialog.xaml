<Window x:Class="Backgammon.Client.Views.Dialog.AddFriendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="{x:Static properties:Resources.TextBlock_Button_AddFriend}"
        Width="420"
        MinHeight="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=textBoxSearchValue}">

    <Window.Resources>
        <SolidColorBrush
            x:Key="DialogBackgroundBrush"
            Color="#080D1A" />

        <SolidColorBrush
            x:Key="CyanAccentBrush"
            Color="#00C9F2" />

        <SolidColorBrush
            x:Key="PinkAccentBrush"
            Color="#E795EC" />

        <Style x:Key="FriendDialogButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background"
                    Value="{StaticResource DialogBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BorderButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#173044" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#22465A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"
                    Value="{StaticResource DialogBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="CaretBrush"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,4" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="BorderInput"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="textBlockPlaceholder"
                                    Text="{TemplateBinding Tag}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Foreground="{StaticResource PinkAccentBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter
                                    TargetName="textBlockPlaceholder"
                                    Property="Visibility"
                                    Value="Visible" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderInput"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="24,16,24,14"
        Background="{StaticResource DialogBackgroundBrush}"
        BorderBrush="{StaticResource CyanAccentBrush}"
        BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                Text="{x:Static properties:Resources.TextBlock_Button_AddFriend}"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource CyanAccentBrush}" />

            <TextBox
                x:Name="textBoxSearchValue"
                Grid.Row="1"
                Tag="{x:Static properties:Resources.TextBox_FriendEmailOrCode}"
                Style="{StaticResource FriendSearchTextBoxStyle}"
                AutomationProperties.Name="{x:Static properties:Resources.TextBox_FriendEmailOrCode}" />

            <TextBlock
                x:Name="textBlockRequiredMessage"
                Grid.Row="2"
                Margin="2,3,0,0"
                Text="{x:Static properties:Resources.TextBlock_FriendSearchRequiredMessage}"
                FontFamily="Segoe UI"
                FontSize="12"
                Foreground="#FF3B4F"
                Visibility="Hidden" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="buttonAddByEmail"
                    Grid.Column="0"
                    Content="{x:Static properties:Resources.Button_AddFriendByEmail}"
                    Style="{StaticResource FriendDialogButtonStyle}"
                    Click="OnAddByEmailClick" />

                <Button
                    x:Name="buttonAddByCode"
                    Grid.Column="2"
                    Content="{x:Static properties:Resources.Button_AddFriendByCode}"
                    Style="{StaticResource FriendDialogButtonStyle}"
                    Click="OnAddByCodeClick" />
            </Grid>

            <Button
                x:Name="buttonClose"
                Grid.Row="4"
                MinWidth="90"
                MinHeight="30"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Content="{x:Static properties:Resources.Button_Close}"
                Style="{StaticResource FriendDialogButtonStyle}"
                IsCancel="True" />
        </Grid>
    </Border>
</Window>
