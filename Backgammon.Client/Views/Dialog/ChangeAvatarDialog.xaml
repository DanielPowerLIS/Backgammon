<Window x:Class="Backgammon.Client.Views.Dialog.ChangeAvatarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Backgammon.Client.Properties"
        Title="{x:Static properties:Resources.TextBlock_SelectAvatarTitle}"
        Width="420"
        MinHeight="240"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <RadialGradientBrush
            x:Key="DialogBackgroundBrush"
            Center="0.5,0.5"
            GradientOrigin="0.5,0.35"
            RadiusX="0.85"
            RadiusY="0.85">

            <GradientStop Color="#171C2B" Offset="0" />
            <GradientStop Color="#0C1220" Offset="0.55" />
            <GradientStop Color="#050914" Offset="1" />
        </RadialGradientBrush>

        <SolidColorBrush
            x:Key="CyanAccentBrush"
            Color="#00C9F2" />

        <SolidColorBrush
            x:Key="PinkAccentBrush"
            Color="#E795EC" />

        <Style
            x:Key="AvatarDialogButtonStyle"
            TargetType="Button">

            <Setter Property="Width" Value="140" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#080D1A" />
            <Setter Property="Foreground"
                    Value="{StaticResource PinkAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CyanAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BorderButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#173044" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource PinkAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BorderButton"
                                    Property="Background"
                                    Value="#22465A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="24,12,24,18"
        Background="{StaticResource DialogBackgroundBrush}"
        BorderBrush="{StaticResource CyanAccentBrush}"
        BorderThickness="2"
        CornerRadius="36">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Width="84"
                Height="84"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Ellipse
                    Fill="#080D1A"
                    Stroke="{StaticResource CyanAccentBrush}"
                    StrokeThickness="2" />

                <Ellipse Margin="10">
                    <Ellipse.Fill>
                        <ImageBrush
                            ImageSource="{Binding Image}"
                            Stretch="Uniform" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,0"
                Text="{x:Static properties:Resources.TextBlock_ChangeAvatarConfirmationMessage}"
                FontFamily="Segoe UI"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource CyanAccentBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="buttonConfirm"
                    Grid.Column="0"
                    Content="{x:Static properties:Resources.Button_Confirm}"
                    Style="{StaticResource AvatarDialogButtonStyle}"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    Click="OnConfirmClick" />

                <Button
                    x:Name="buttonCancel"
                    Grid.Column="2"
                    Content="{x:Static properties:Resources.Button_Cancel}"
                    Style="{StaticResource AvatarDialogButtonStyle}"
                    HorizontalAlignment="Center"
                    IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
