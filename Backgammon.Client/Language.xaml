<Page x:Class="Backgammon.Client.Language"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client"
      xmlns:properties="clr-namespace:Backgammon.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Language"
      Background="White">

    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="{x:Static properties:Resources.Language}" VerticalAlignment="Top" FontSize="45"/>
        <StackPanel Margin="31,87,31,87">
            <Button Content="{x:Static properties:Resources.Spanish}" Width="129" Height="29" Margin="0,10,0,10" FontSize="14"/>
            <Button Content="{x:Static properties:Resources.English}" Width="130" Height="29" Margin="0,10,0,10" FontSize="14"/>
        </StackPanel>

    </Grid>
</Page>
