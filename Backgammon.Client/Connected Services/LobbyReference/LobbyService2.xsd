<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/Backgammon.Server.Services.Data" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/Backgammon.Server.Services.Data" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Lobby">
    <xs:sequence>
      <xs:element minOccurs="0" name="CurrentState" type="tns:LobbyState" />
      <xs:element minOccurs="0" name="GuestPlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="HostPlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="RoomId" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Lobby" nillable="true" type="tns:Lobby" />
  <xs:simpleType name="LobbyState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="WaitingForPlayers" />
      <xs:enumeration value="InGame" />
      <xs:enumeration value="Finished" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="LobbyState" nillable="true" type="tns:LobbyState" />
</xs:schema>