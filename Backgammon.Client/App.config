<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Backgammon.Client.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <userSettings>
    <Backgammon.Client.Properties.Settings>
      <setting name="LanguageCultureName" serializeAs="String">
        <value>en-US</value>
      </setting>
    </Backgammon.Client.Properties.Settings>
  </userSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpBinding_ILeaderboardService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IAuthenticationService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_ILogOutService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IRegistrationService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IProfileService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IGuestAccessService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IPreinitiationService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:9001/LeaderboardService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ILeaderboardService"
        contract="LeaderboardReference.ILeaderboardService" name="NetTcpBinding_ILeaderboardService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/AuthenticationService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IAuthenticationService"
        contract="AuthenticationReference.IAuthenticationService" name="NetTcpBinding_IAuthenticationService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/LogOutService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_ILogOutService" contract="LogOutReference.ILogOutService"
        name="NetTcpBinding_ILogOutService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/RegistrationService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IRegistrationService"
        contract="RegistrationReference.IRegistrationService" name="NetTcpBinding_IRegistrationService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/ProfileService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IProfileService" contract="ProfileReference.IProfileService"
        name="NetTcpBinding_IProfileService">
        <identity>
          <userPrincipalName value="DANIELLIS\jdani" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/GuestAccessService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IGuestAccessService"
        contract="GuestAccessReference.IGuestAccessService" name="NetTcpBinding_IGuestAccessService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:9001/PreinitiationService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IPreinitiationService" contract="PreinitiationReference.IPreinitiationService"
        name="NetTcpBinding_IPreinitiationService">
        <identity>
          <userPrincipalName value="ADAIR\adair" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>