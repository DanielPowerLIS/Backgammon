<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Backgammon.Client"
      xmlns:Properties="clr-namespace:Backgammon.Client.Properties" x:Class="Backgammon.Client.Rules"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Rules"
      Background="White">

    <Grid>

        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="{x:Static Properties:Resources.Rules}" VerticalAlignment="Top" FontSize="45"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" Height="270" VerticalAlignment="Center" Width="740">
            <TextBlock TextWrapping="Wrap" Text="{x:Static Properties:Resources.GameRules}" Margin="41,9,41,25" TextAlignment="Justify"/>
        </Border>
        <Button Content="{x:Static Properties:Resources.Back}" HorizontalAlignment="Left" Margin="725,378,0,0" VerticalAlignment="Top" Width="45" Height="25"/>

    </Grid>
</Page>
